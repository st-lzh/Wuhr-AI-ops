  @@unique([deviceId, ifIndex])
  @@index([deviceId])
  @@index([name])
  @@index([operStatus])
}

model network_metrics {
  id               String           @id
  deviceId         String?
  interfaceId      String?
  timestamp        DateTime         @default(now())
  cpuUsage         Float?
  cpuLoad1         Float?
  cpuLoad5         Float?
  cpuLoad15        Float?
  memoryUsage      Float?
  memoryUsed       BigInt?
  memoryFree       BigInt?
  temperature      Float?
  fanSpeed         Int?
  powerConsumption Float?
  bandwidth        BigInt?
  packetRate       BigInt?
  utilization      Float?
  errorRate        Float?
  discardRate      Float?
  arpEntries       Int?
  macEntries       Int?
  routeEntries     Int?
  bgpPeers         Int?
  ospfNeighbors    Int?
  tcpConnections   Int?
  udpConnections   Int?
  network_devices  network_devices? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([interfaceId])
  @@index([timestamp])
}

model network_topology {
  id              String          @id
  sourceDeviceId  String
  sourcePort      String          @db.VarChar(100)
  sourcePortId    String?         @db.VarChar(100)
  targetDeviceId  String
  targetPort      String          @db.VarChar(100)
  targetPortId    String?         @db.VarChar(100)
  linkType        String          @db.VarChar(20)
  protocol        String?         @db.VarChar(20)
  linkSpeed       BigInt?
  discovered      Boolean         @default(false)
  discoveryMethod String?         @db.VarChar(20)
  status          String          @default("active") @db.VarChar(20)
  lastVerified    DateTime        @default(now())
  distance        Int?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  network_devices network_devices @relation(fields: [sourceDeviceId], references: [id], onDelete: Cascade)

  @@index([sourceDeviceId])
  @@index([status])
  @@index([targetDeviceId])
}

model workflow_executions {
  id                  String              @id
  workflowId          String
  status              ExecutionStatus     @default(RUNNING)
  input               Json
  output              Json?
  logs                Json?
  error               String?
  executionTime       Int?
  tokenUsage          Json?
  triggeredBy         String?             @db.VarChar(100)
  triggerSource       String?             @db.VarChar(50)
  startedAt           DateTime            @default(now())
  completedAt         DateTime?
  knowledge_workflows knowledge_workflows @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([startedAt])
  @@index([workflowId])
  @@index([workflowId, status])
}

