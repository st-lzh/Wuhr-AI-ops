  @@index([category])
  @@index([parentId])
  @@index([userId])
}

model network_devices {
  id                    String                 @id
  name                  String                 @db.VarChar(100)
  displayName           String?                @db.VarChar(100)
  type                  DeviceType
  vendor                DeviceVendor
  model                 String                 @db.VarChar(100)
  serialNumber          String?                @db.VarChar(100)
  ip                    String                 @unique @db.VarChar(45)
  snmpPort              Int                    @default(161)
  sshPort               Int                    @default(22)
  httpPort              Int?
  httpsPort             Int?
  sshUsername           String?                @db.VarChar(100)
  sshPassword           String?                @db.VarChar(500)
  sshKeyPath            String?                @db.VarChar(500)
  snmpVersion           String                 @default("v2c") @db.VarChar(10)
  snmpCommunity         String?                @db.VarChar(100)
  snmpUsername          String?                @db.VarChar(100)
  snmpAuthPass          String?                @db.VarChar(500)
  snmpPrivPass          String?                @db.VarChar(500)
  status                DeviceStatus           @default(UNKNOWN)
  isActive              Boolean                @default(true)
  lastPolled            DateTime?
  uptime                BigInt?
  lastOnline            DateTime?
  location              String?                @db.VarChar(200)
  datacenter            String?                @db.VarChar(100)
  rack                  String?                @db.VarChar(50)
  rackUnit              Int?
  building              String?                @db.VarChar(100)
  floor                 String?                @db.VarChar(50)
  room                  String?                @db.VarChar(100)
  osVersion             String?                @db.VarChar(100)
  firmwareVersion       String?                @db.VarChar(100)
  bootromVersion        String?                @db.VarChar(100)
  hardwareVersion       String?                @db.VarChar(100)
  cpuUsage              Float?
  memoryUsage           Float?
  memoryTotal           BigInt?
  temperature           Float?
  fanStatus             String?                @db.VarChar(50)
  powerStatus           String?                @db.VarChar(50)
  groupId               String?
  tags                  String[]
  description           String?
  notes                 String?
  userId                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  createdBy             String?                @db.VarChar(100)
  updatedBy             String?                @db.VarChar(100)
  device_configs        device_configs[]
  healing_logs          healing_logs[]
  network_alerts        network_alerts[]
  network_device_groups network_device_groups? @relation(fields: [groupId], references: [id])
  users                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  network_interfaces    network_interfaces[]
  network_metrics       network_metrics[]
  network_topology      network_topology[]

  @@index([datacenter])
  @@index([groupId])
  @@index([ip])
  @@index([isActive])
  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([vendor])
}

model network_interfaces {
  id               String          @id
  deviceId         String
  ifIndex          Int
  name             String          @db.VarChar(100)
  alias            String?         @db.VarChar(200)
  type             String?         @db.VarChar(50)
  macAddress       String?         @db.VarChar(20)
  mtu              Int?
  ipAddress        String?         @db.VarChar(45)
  subnetMask       String?         @db.VarChar(45)
  ipv6Address      String?         @db.VarChar(50)
  adminStatus      String          @db.VarChar(20)
  operStatus       String          @db.VarChar(20)
  speed            BigInt?
  duplex           String?         @db.VarChar(20)
  vlanId           Int?
  vlanMode         String?         @db.VarChar(20)
  allowedVlans     String?         @db.VarChar(500)
  nativeVlan       Int?
  inOctets         BigInt?
  outOctets        BigInt?
  inUcastPkts      BigInt?
  outUcastPkts     BigInt?
  inBroadcastPkts  BigInt?
  outBroadcastPkts BigInt?
  inErrors         BigInt?
  outErrors        BigInt?
  inDiscards       BigInt?
  outDiscards      BigInt?
  crcErrors        BigInt?
  bandwidth        BigInt?
  utilization      Float?
  isTrunkMember    Boolean         @default(false)
  trunkId          String?         @db.VarChar(50)
