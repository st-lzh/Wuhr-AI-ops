  visibility              AppVisibility             @default(PRIVATE)
  dailyLimit              Int?
  rateLimitPerMinute      Int?
  usageCount              Int                       @default(0)
  lastUsedAt              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  model_providers         model_providers?          @relation(fields: [llmProviderId], references: [id])
  users                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledge_workflows     knowledge_workflows       @relation(fields: [workflowId], references: [id])
  knowledge_conversations knowledge_conversations[]

  @@index([llmProviderId])
  @@index([userId])
  @@index([userId, isPublished])
  @@index([workflowId])
}

model knowledge_bases {
  id                                                                   String                @id
  userId                                                               String
  name                                                                 String                @db.VarChar(100)
  description                                                          String?
  icon                                                                 String?               @db.VarChar(50)
  color                                                                String?               @db.VarChar(20)
  embeddingProviderId                                                  String
  embeddingModel                                                       String                @db.VarChar(100)
  embeddingDimension                                                   Int
  vectorDBProviderId                                                   String?
  collectionName                                                       String                @db.VarChar(100)
  chunkSize                                                            Int                   @default(500)
  chunkOverlap                                                         Int                   @default(50)
  separators                                                           String[]              @default(["\\n\\n", "\\n", "。", ".", " "])
  defaultTopK                                                          Int                   @default(5)
  defaultThreshold                                                     Float                 @default(0.5)
  rerankingEnabled                                                     Boolean               @default(false)
  rerankingModel                                                       String?               @db.VarChar(100)
  documentCount                                                        Int                   @default(0)
  chunkCount                                                           Int                   @default(0)
  totalSize                                                            BigInt                @default(0)
  status                                                               KnowledgeBaseStatus   @default(ACTIVE)
  indexStatus                                                          IndexStatus           @default(PENDING)
  lastIndexedAt                                                        DateTime?
  createdAt                                                            DateTime              @default(now())
  updatedAt                                                            DateTime
  model_providers_knowledge_bases_embeddingProviderIdTomodel_providers model_providers       @relation("knowledge_bases_embeddingProviderIdTomodel_providers", fields: [embeddingProviderId], references: [id])
  users                                                                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  model_providers_knowledge_bases_vectorDBProviderIdTomodel_providers  model_providers?      @relation("knowledge_bases_vectorDBProviderIdTomodel_providers", fields: [vectorDBProviderId], references: [id])
  knowledge_documents                                                  knowledge_documents[]
  knowledge_workflows                                                  knowledge_workflows[] @relation("WorkflowKnowledgeBases")

  @@index([embeddingProviderId])
  @@index([userId])
  @@index([userId, status])
  @@index([vectorDBProviderId])
}

model knowledge_conversations {
  id                 String               @id
  applicationId      String
  userId             String
  title              String?              @db.VarChar(255)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  knowledge_apps     knowledge_apps       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  users              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledge_messages knowledge_messages[]

  @@index([applicationId])
  @@index([userId])
}

model knowledge_documents {
  id              String            @id
  knowledgeBaseId String
  name            String            @db.VarChar(255)
  type            DocumentType
  mimeType        String?           @db.VarChar(100)
  size            BigInt
  hash            String?           @db.VarChar(64)
  storagePath     String?           @db.VarChar(500)
  content         String?
  status          DocumentStatus    @default(PENDING)
  processedAt     DateTime?
  processingError String?
  chunkCount      Int               @default(0)
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  document_chunks document_chunks[]
  knowledge_bases knowledge_bases   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, hash])
  @@index([knowledgeBaseId])
  @@index([knowledgeBaseId, status])
}

model knowledge_messages {
  id                      String                  @id
  conversationId          String
  role                    KnowledgeMessageRole
  content                 String
  metadata                Json?
  tokenCount              Int?
  feedback                MessageFeedback?
  feedbackAt              DateTime?
  createdAt               DateTime                @default(now())
  knowledge_conversations knowledge_conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model knowledge_workflows {
  id                  String                @id
  userId              String
  name                String                @db.VarChar(100)
  description         String?
  icon                String?               @db.VarChar(50)
  definition          Json
  version             Int                   @default(1)
  isPublished         Boolean               @default(false)
  publishedAt         DateTime?
  publishedVersion    Int?
  status              WorkflowStatus        @default(DRAFT)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  knowledge_apps      knowledge_apps[]
  users               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow_executions workflow_executions[]
  knowledge_bases     knowledge_bases[]     @relation("WorkflowKnowledgeBases")

  @@index([userId])
  @@index([userId, status])
}

model model_providers {
  id                                                                   String               @id
  userId                                                               String
  name                                                                 String               @db.VarChar(100)
  type                                                                 ProviderType
  category                                                             ProviderCategory
  baseUrl                                                              String?              @db.VarChar(500)
  apiKey                                                               String?              @db.VarChar(500)
  secretKey                                                            String?              @db.VarChar(500)
  config                                                               Json?
  isDefault                                                            Boolean              @default(false)
  isActive                                                             Boolean              @default(true)
  lastTestedAt                                                         DateTime?
  testResult                                                           String?              @db.VarChar(500)
  createdAt                                                            DateTime             @default(now())
  updatedAt                                                            DateTime
  providerKey                                                          String               @default("openai-compatible") @db.VarChar(50)
  adapter                                                              String               @default("openai-compatible") @db.VarChar(50)
  modelConfigs                                                         ModelConfig[]
  providerCatalog                                                      ModelProviderCatalog @relation(fields: [providerKey], references: [id])
  knowledge_apps                                                       knowledge_apps[]
  knowledge_bases_knowledge_bases_embeddingProviderIdTomodel_providers knowledge_bases[]    @relation("knowledge_bases_embeddingProviderIdTomodel_providers")
  knowledge_bases_knowledge_bases_vectorDBProviderIdTomodel_providers  knowledge_bases[]    @relation("knowledge_bases_vectorDBProviderIdTomodel_providers")
  users                                                                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([userId, category])
  @@index([userId])
  @@index([providerKey])
}

model network_alerts {
  id              String           @id
  deviceId        String?
  interfaceId     String?
  type            String           @db.VarChar(50)
  level           String           @db.VarChar(20)
  category        String?          @db.VarChar(50)
  title           String           @db.VarChar(255)
  message         String
  metric          String?          @db.VarChar(100)
  threshold       Float?
  currentValue    Float?
  unit            String?          @db.VarChar(20)
  severity        String?          @db.VarChar(20)
  impact          String?
  isResolved      Boolean          @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?          @db.VarChar(100)
  resolution      String?
  isNotified      Boolean          @default(false)
  notifiedAt      DateTime?
  notifyChannels  String[]
  relatedAlerts   String[]
